<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.Toolbar
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorPrimary"
    android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:layout_scrollFlags="scroll|enterAlways"
    app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/activity_vertical_padding"
        android:paddingBottom="@dimen/activity_vertical_padding">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:hint="@string/search"
            android:fontFamily="@font/proximanova_regular"
            android:paddingLeft="@dimen/activity_horizontal_padding"
            android:textColorHint="@color/dark_gray"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/black"
            android:background="@drawable/shape_textsearch"/>

        <LinearLayout
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:background="@drawable/shape_btnclearsearch">

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginRight="5dp"
                android:background="@android:color/transparent"
                app:srcCompat="@drawable/ic_clear_search"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="80dp"
            android:layout_weight="0"
            android:layout_height="match_parent"
            android:layout_marginRight="4dp"
            android:layout_marginLeft="16dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnAccount"
                android:layout_width="30dp"
                android:layout_height="35dp"
                android:background="@android:color/transparent"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/ic_account"/>

            <RelativeLayout
                android:layout_width="30dp"
                android:layout_height="35dp"
                android:layout_marginLeft="@dimen/activity_horizontal_margin"
                android:layout_marginStart="@dimen/activity_horizontal_margin">

                <ImageButton
                    android:id="@+id/btnNotification"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:scaleType="fitXY"
                    app:srcCompat="@drawable/ic_notifications" />

                <TextView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="@dimen/activity_vertical_vsmall_margin"
                    android:background="@drawable/shape_circle_notification"
                    android:gravity="center"
                    android:text="99+"
                    android:textSize="8sp"
                    android:textColor="@color/white"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true" />

            </RelativeLayout>


        </LinearLayout>

    </LinearLayout>

</android.support.v7.widget.Toolbar>