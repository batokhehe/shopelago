<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/activity_vertical_margin"
            android:layout_marginRight="@dimen/activity_vertical_margin"
            android:layout_marginTop="5dp"
            android:padding="@dimen/activity_horizontal_padding"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"
                android:fontFamily="@font/proximanova_bold"
                android:text="@string/tab_all"
                android:textSize="14dp"
                android:textColor="@color/light_green"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                />

            <TextView
                android:id="@+id/tvProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"
                android:fontFamily="@font/proximanova_regular"
                android:text="@string/tab_product"
                android:textSize="14dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                />


            <TextView
                android:id="@+id/tvShop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"
                android:fontFamily="@font/proximanova_regular"
                android:text="@string/tab_shop"
                android:textSize="14dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                />


        </LinearLayout>

        <View
            style="@style/horizontal_gray_divider"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layoutSearchAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!--<TextView-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:layout_marginLeft="@dimen/activity_vertical_margin"-->
                <!--android:layout_marginRight="@dimen/activity_vertical_margin"-->
                <!--android:layout_marginTop="20dp"-->
                <!--android:layout_marginBottom="10dp"-->
                <!--android:fontFamily="@font/proximanova_bold"-->
                <!--android:text="@string/tab_product"-->
                <!--android:textSize="20dp"-->
                <!--android:textColor="@color/colorPrimaryDark"-->
                <!--/>-->

                <LinearLayout
                    android:id="@+id/llProductResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <android.support.v7.widget.RecyclerView
                        android:id="@+id/rvProductResult"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:listitem="@layout/rv_item_search_product_result"
                        android:layout_marginBottom="@dimen/activity_vertical_small_margin" />


                    <TextView
                        android:id="@+id/tvLoadMoreProduct"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/activity_vertical_margin"
                        android:layout_marginRight="@dimen/activity_vertical_margin"
                        android:fontFamily="@font/proximanova_regular"
                        android:text="@string/load_more"
                        android:background="?android:attr/selectableItemBackground"
                        android:textSize="15dp"
                        android:drawableRight="@drawable/ic_load_more"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmptyProductResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_small_margin"
                    android:gravity="center_horizontal"
                    android:text="@string/title_product_not_found"
                    android:textStyle="italic"
                    android:textColor="@color/gray"
                    android:visibility="gone"/>

                <View style="@style/horizontal_gray_divider"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/activity_vertical_margin"
                    android:layout_marginRight="@dimen/activity_vertical_margin"
                    android:layout_marginTop="10dp"
                    />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/activity_vertical_margin"
                    android:layout_marginRight="@dimen/activity_vertical_margin"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/proximanova_bold"
                    android:text="@string/tab_shop"
                    android:textSize="20dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:textColor="@color/colorPrimaryDark"
                    />

                <LinearLayout
                    android:id="@+id/llShopResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <android.support.v7.widget.RecyclerView
                        android:id="@+id/rvShopResult"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:listitem="@layout/rv_item_search_shop_result"
                        android:layout_marginBottom="@dimen/activity_vertical_small_margin" />


                    <TextView
                        android:id="@+id/tvLoadMoreShop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/activity_vertical_margin"
                        android:layout_marginRight="@dimen/activity_vertical_margin"
                        android:fontFamily="@font/proximanova_regular"
                        android:text="@string/load_more"
                        android:textSize="15dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:drawableRight="@drawable/ic_load_more"
                        />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmptyShopResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_small_margin"
                    android:gravity="center_horizontal"
                    android:text="@string/title_shop_not_found"
                    android:textStyle="italic"
                    android:textColor="@color/gray"
                    android:visibility="gone"/>

                <View style="@style/horizontal_gray_divider"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/activity_vertical_margin"
                    android:layout_marginRight="@dimen/activity_vertical_margin"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</LinearLayout>