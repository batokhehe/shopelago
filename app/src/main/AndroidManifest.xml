<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.shopelago">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ShopelagoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_shopelago"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_shopelago"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".view.activities.SignUpActivity" />
        <activity android:name=".view.activities.SignInActivity" />
        <activity android:name=".view.activities.ForgotPasswordActivity" />
        <activity android:name=".view.activities.SplashScreenActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustPan" />
    </application>

</manifest>